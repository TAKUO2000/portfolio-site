# ブラウザ(クライアントコンポーネント)から見たAPIのベースURL。
# ビルド時にクライアントのJSへ埋め込まれるため、値を変えたらビルドし直す。
# 本番のビルド(next build)では必須で、未設定ならビルドが失敗する。
# 開発中に未設定のときは http://localhost:8000 を使う
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# サーバーコンポーネント(SSR)から見たAPIのベースURL。設定するとNEXT_PUBLIC_API_BASE_URLより優先される。
# docker composeではコンテナ内部からlocalhostに届かないため、compose側で http://web を設定している。
# Vercelなど、SSRからもNEXT_PUBLIC_API_BASE_URLに届く環境では設定しない
# API_INTERNAL_BASE_URL=http://web

# next/imageで表示を許可するS3のバケットのホスト名(https)。
# 本番のビルドでは、これかS3_PUBLIC_ENDPOINTのどちらかが必須
# S3_IMAGE_HOST=<バケット名>.s3.ap-northeast-1.amazonaws.com

# MinIOのブラウザから届くエンドポイント(例: http://localhost:9000)。ローカル開発専用。
# docker composeではcompose側で設定している。
# 設定するとnext/imageの最適化が無効(unoptimized)になるため、本番では設定しない
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# 記事の変更時にAPIから呼ばれる再検証（app/api/revalidate）のシークレット。
# laravel-backの FRONTEND_REVALIDATE_SECRET と同じ値にする。未設定なら再検証を受け付けない
REVALIDATE_SECRET=
