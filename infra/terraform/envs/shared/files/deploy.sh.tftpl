#!/bin/bash
# SSM ドキュメント portfolio-deploy の中身（EC2 の root で実行される）。
# {{ imageTag }} は SSM が引数で置き換える（ドキュメントの allowedPattern で形を縛っている）。
# Terraform の templatefile を通すので、シェルの変数は $NAME の形だけで書く
set -euo pipefail
export HOME=/root

TAG='{{ imageTag }}'
REGION='${region}'
BUCKET='${bucket}'
REGISTRY='${registry}'
REPOSITORY='${repository}'
DIR=/opt/portfolio
COMPOSE="docker compose -f $DIR/docker-compose.prod.yml --project-directory $DIR"

# 本番に develop- のイメージを入れない（user_data が書いた環境の名前と、タグの接頭辞を比べる）
. /etc/portfolio-env
case "$PORTFOLIO_ENV:$TAG" in
  prod:main-* | stg:develop-*) ;;
  *) echo "この EC2（$PORTFOLIO_ENV）には $TAG をデプロイできません" >&2; exit 1 ;;
esac

# 部品を取ってから、3つとも揃っているのを確かめて入れ替える（途中で失敗したら、今のファイルは変えない）
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
aws s3 cp --region "$REGION" --only-show-errors "s3://$BUCKET/bundles/$TAG.tar.gz" "$WORK/bundle.tar.gz"
mkdir "$WORK/bundle"
tar -xzf "$WORK/bundle.tar.gz" -C "$WORK/bundle"
for f in docker-compose.prod.yml laravel-back/docker/nginx/prod.conf infra/terraform/modules/app/files/render-env.sh; do
  if [ ! -s "$WORK/bundle/$f" ]; then
    echo "部品に $f がありません" >&2
    exit 1
  fi
done

install -m 700 "$WORK/bundle/infra/terraform/modules/app/files/render-env.sh" /usr/local/bin/portfolio-render-env
install -d -m 700 "$DIR"
install -m 600 "$WORK/bundle/docker-compose.prod.yml" "$DIR/docker-compose.prod.yml"
install -d -m 755 "$DIR/laravel-back/docker/nginx"
install -m 644 "$WORK/bundle/laravel-back/docker/nginx/prod.conf" "$DIR/laravel-back/docker/nginx/prod.conf"
echo "placed the bundle for $TAG"

# .env と .env.production を Parameter Store から作り直す（.env の APP_IMAGE を今回のタグにする）
/usr/local/bin/portfolio-render-env "$REGISTRY/$REPOSITORY:$TAG"

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY"
$COMPOSE pull --quiet
# nginx は app が healthy になってから起動する（depends_on）。app のマイグレーションが失敗すると、ここで失敗する
$COMPOSE up -d --remove-orphans

APP_ID=$($COMPOSE ps -q app)
APP_HEALTH=$(docker inspect "$APP_ID" | python3 -c 'import json, sys; print(json.load(sys.stdin)[0]["State"]["Health"]["Status"])')
$COMPOSE ps
if [ "$APP_HEALTH" != "healthy" ]; then
  echo "app が healthy になっていません（$APP_HEALTH）。docker compose logs app で原因を確かめてください" >&2
  exit 1
fi
echo "deployed $TAG"
