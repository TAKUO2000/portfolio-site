#!/bin/bash
# EC2 を初めて起動したときだけ実行される（ignore_changes = [user_data] なので、あとから変えても反映されない）。
# ログは /var/log/cloud-init-output.log
set -euxo pipefail

# --- swap 2GB（メモリ 1GB の t4g.micro で、ビルドやマイグレーションのときに OOM で落ちないように） ---
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi

# --- Docker と compose のプラグイン ---
dnf install -y docker
systemctl enable --now docker

# Amazon Linux 2023 のリポジトリには compose のプラグインが無いので、バージョンを固定して GitHub のリリースから入れる
COMPOSE_VERSION=v5.6.1
COMPOSE_SHA256=42cfa75f51ad0ccf290bad37899e0038a8c10a0069e85233ecc1d53e3ff1347d
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64"
echo "$COMPOSE_SHA256  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# --- 環境ごとの追加の処理（本番はデータ用 EBS を /data にマウントする） ---
${extra_user_data}

# --- /data（MySQL のデータと証明書。compose がマウントする） ---
mkdir -p /data/mysql /data/letsencrypt

# --- .env と .env.production を Parameter Store から作るスクリプト（デプロイ用の SSM ドキュメントからも使う） ---
mkdir -p /opt/portfolio
chmod 700 /opt/portfolio
cat > /usr/local/bin/portfolio-render-env <<'RENDER_ENV'
${render_env}
RENDER_ENV
chmod 700 /usr/local/bin/portfolio-render-env
echo 'PORTFOLIO_ENV=${env}' > /etc/portfolio-env
