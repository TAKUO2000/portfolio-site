# docker composeで使う設定値。`make setup`で.envにコピーされる。
# ここで定義したDB/MinIOの接続情報はcompose側からappコンテナに注入されるため、
# laravel-back/.envを書き換える必要はない。

# mysqlサービスの初期化とホスト側ポート公開に使用
DB_DATABASE=laravel_back
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ホスト側で公開するポート。他のプロジェクトと衝突する場合はここを変更する。
# BACKEND_PORTを変えたときはnextjs-front/.envのNEXT_PUBLIC_API_BASE_URLも合わせる。
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=3307

# minioサービス（ローカル用のS3互換ストレージ）の設定。
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD はそのままLaravelのAWS認証情報として使われる。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# minio-initが作成し、Laravel/Next.jsが参照する画像用バケット
AWS_BUCKET=portfolio-images
AWS_DEFAULT_REGION=ap-northeast-1
