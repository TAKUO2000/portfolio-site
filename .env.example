# Used by docker-compose to provision the mysql service and host port mappings.
# Keep DB_DATABASE / DB_USERNAME / DB_PASSWORD in sync with laravel-back/.env.
DB_DATABASE=laravel_back
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=3307

# Used by docker-compose to provision the minio service (local S3-compatible storage).
# Keep AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in sync with laravel-back/.env.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
