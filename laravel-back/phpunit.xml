<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- 本番と同じMySQLで検証するため、テストは専用データベースに接続する。
             開発用DBを指したままだと、テストのマイグレーションで開発データが壊れる。
             接続先(DB_HOST/PORT/USERNAME/PASSWORD)は環境の値をそのまま使う。
             Laravelのenv()はgetenvだけでなく$_SERVERも参照するため、
             env/serverの両方にforce="true"で指定する必要がある。 -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="laravel_back_testing" force="true"/>
        <server name="DB_DATABASE" value="laravel_back_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <server name="FILESYSTEM_DISK" value="local" force="true"/>
        <env name="AWS_ENDPOINT" value="" force="true"/>
        <server name="AWS_ENDPOINT" value="" force="true"/>
        <env name="AWS_PUBLIC_ENDPOINT" value="" force="true"/>
        <server name="AWS_PUBLIC_ENDPOINT" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
