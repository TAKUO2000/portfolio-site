# 本番（api.takuosblog.com）用の環境変数の雛形。値の根拠は infra/design.md。
# デプロイ時に EC2 上で、docker-compose.prod.yml と同じディレクトリにこの形の .env.production（パーミッション 600）を作る。
# リポジトリにもイメージにも本物の値は入れない。
# 秘密（APP_KEY・DB_PASSWORD・DB_ROOT_PASSWORD・FRONTEND_REVALIDATE_SECRET）は SSM Parameter Store（/portfolio/prod/*）から入れる。
#
# ステージングで変える値：
#   APP_ENV=staging / APP_URL=https://api.stg.takuosblog.com / FRONTEND_URL=https://stg.takuosblog.com
#   SANCTUM_STATEFUL_DOMAINS=stg.takuosblog.com / SESSION_DOMAIN=.stg.takuosblog.com
#   SESSION_COOKIE=portfolio_stg_session / 秘密は /portfolio/stg/* から / API_DOMAIN=api.stg.takuosblog.com / APP_IMAGE は develop-<SHA>

# docker-compose.prod.yml が使う値（Laravel は読まない）
# ECR のイメージ。デプロイのたびにタグ（main-<コミットの SHA>）を書き換える
APP_IMAGE=<アカウントID>.dkr.ecr.ap-northeast-1.amazonaws.com/portfolio/app:main-<SHA>
# nginx の server_name と証明書のパス（/etc/letsencrypt/live/<API_DOMAIN>/）
API_DOMAIN=api.takuosblog.com

APP_NAME=TAKUO_Log
APP_ENV=production
# Parameter Store（php artisan key:generate --show で作った値）
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.takuosblog.com
FRONTEND_URL=https://takuosblog.com
# Parameter Store。記事の変更時に FRONTEND_URL/api/revalidate を呼び、トップページの記事一覧を作り直させる。
# Vercel の REVALIDATE_SECRET と同じ値にする（openssl rand -hex 32 などで作る）
FRONTEND_REVALIDATE_SECRET=

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

# docker compose logs で見るため、ファイルではなく標準エラーに出す
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# DB_HOST は docker-compose.prod.yml の MySQL のサービス名
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
# Parameter Store
DB_PASSWORD=
# Parameter Store（mysql コンテナの初期化用）
DB_ROOT_PASSWORD=

# 認証（FE と API で親ドメインを共有し、Cookie をそこへ発行する）
SANCTUM_STATEFUL_DOMAINS=takuosblog.com
SESSION_DRIVER=database
SESSION_DOMAIN=.takuosblog.com
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=portfolio_session

CACHE_STORE=database
QUEUE_CONNECTION=database

# 画像（実 AWS S3）。AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY は書かない。
# EC2 のインスタンスロールの一時的な認証情報を SDK が使う（app/Services/ImageStorage.php）
FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=ap-northeast-1
# 本番用バケット名（#53 で決める）
AWS_BUCKET=
AWS_ENDPOINT=
AWS_PUBLIC_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# メール（Amazon SES）。パスワード再設定とメールアドレスの確認のメールを送る（#81）。
# 認証情報はインスタンスロールから取るので、キーは書かない。送る前に AWS 側の準備（ドメインの検証、
# サンドボックスの解除、ses:SendRawEmail の権限）が要る。手順は #53 の「メール送信（Amazon SES）」
# log にするとメールは送られず、本文（トークン入りのリンク）が debug レベルでログに出るので、本番では使わない
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="no-reply@takuosblog.com"
MAIL_FROM_NAME="${APP_NAME}"
