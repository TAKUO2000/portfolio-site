# docker-compose.prod.yml の変数の置き換えに使う値の雛形。EC2 では compose と同じディレクトリに .env としてコピーする
# （パーミッション 600、リポジトリには入れない）。ここの値はコンテナには渡らない。
# 秘密（DB_PASSWORD・DB_ROOT_PASSWORD）は SSM Parameter Store（/portfolio/prod/*）から入れる。
#
# ステージングで変える値：APP_IMAGE は develop-<SHA> / API_DOMAIN=api.stg.takuosblog.com / 秘密は /portfolio/stg/* から

# ECR のイメージ。デプロイのたびにタグ（main-<コミットの SHA>）を書き換える
APP_IMAGE=<アカウントID>.dkr.ecr.ap-northeast-1.amazonaws.com/portfolio/app:main-<SHA>
# nginx の server_name と証明書のパス（/etc/letsencrypt/live/<API_DOMAIN>/）
API_DOMAIN=api.takuosblog.com

# MySQL の初期化に使う（データを初めて作るときだけ）。DB_DATABASE・DB_USERNAME・DB_PASSWORD は
# laravel-back/.env.production.example と同じ値にする
DB_DATABASE=portfolio
DB_USERNAME=portfolio
# Parameter Store
DB_PASSWORD=
# Parameter Store。ここにだけ置き、app と scheduler には渡さない
DB_ROOT_PASSWORD=
